# ============================================
# InsightFlow — Environment Variables
# ============================================
# Copy to `.env` (server) and fill in real values. NEVER commit the filled-in
# file — `.env` is gitignored. `.env.example` is the only tracked template.
#
#   cp server/.env.example server/.env
#
# ============================================


# ---------- Required ----------

# Signed identity + database.
# SUPABASE_DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/postgres?sslmode=require

# Server-issued, HMAC-signed visitor token. Used to prove a request owns a
# project, so a client cannot claim someone else's identity.
# Generate a strong value:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Must be at least 32 characters. Rotating it invalidates all existing sessions.
VISITOR_SECRET=

# Google Gemini API key used by the AI planning/execution layer.
GEMINI_API_KEY=


# ---------- Required in production only ----------

# Set to "production" to enable strict behavior:
#   - TLS certificate verification on Postgres
#   - /data debug endpoint disabled
#   - VISITOR_SECRET length enforced
NODE_ENV=development

# Comma-separated list of browser origins allowed to call this API.
# Required in production (the server refuses to boot without it).
# Example: https://app.example.com,https://www.example.com
# CORS_ORIGINS=


# ---------- Optional ----------

# Port the Express server listens on. Platforms often inject this.
# PORT=5001

# Max upload size in bytes. Default 25MB.
# UPLOAD_MAX_BYTES=26214400


# ============================================
# Client (REACT_APP_*) — set in the build environment
# ============================================
# These are baked into the bundle at build time by Create React App, so they
# must be provided as env vars when running `npm run build`, not at runtime.
# Put them in client/.env (gitignored) or your host's build settings.
#
# Base URL of the backend API.
# REACT_APP_API_URL=http://localhost:5001